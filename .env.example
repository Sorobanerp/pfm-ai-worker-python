# PFM AI Worker Python — Local Profile Example (Run ../init-local-development.sh to generate .env.local)
APP_ENV=local
WORKER_PORT=18400
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=pfm-ai-worker-local-group
PFM_AI_RULES_DSN=postgresql://pfm_ai_user:<LOCAL_PASSWORD>@localhost:15433/pfm_ai_rules
AWS_ENDPOINT_URL=http://localhost:4566
GEMINI_API_KEY=
# Datadog Unified Service Tagging & OpenTelemetry (Plug-and-Play ADR-010)
DD_SERVICE=pfm-ai-worker-python
DD_ENV=local
DD_VERSION=0.1.0-local
DD_LOGS_INJECTION=true
DD_TRACE_SAMPLE_RATE=1.0
DD_SITE=us3.datadoghq.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CLOUDWATCH_LOGS_ENABLED=false
DD_API_KEY=
