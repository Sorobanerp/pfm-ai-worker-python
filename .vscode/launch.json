{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PFM AI Worker Python (APP_ENV=local)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env.local",
